
# These reports are written by scripts, and review-trait-audit.mjs --check
# re-renders one and compares it byte for byte. On a machine with
# core.autocrlf=true git hands the script CRLF while the renderer emits LF, so
# the check reports a stale report that git itself sees as unchanged. Keep them
# LF in the working tree so the comparison means what it says.
review/reports/*.md text eol=lf

# Same reasoning for the generated GCS sheets: build-gcs-sheets.mjs --check
# compares the file on disk to freshly rendered LF output byte for byte, so a
# CRLF checkout would report every sheet stale while git sees no change.
converted/enraged-eggplant/gcs-sheets/*.gcs text eol=lf

# Same reasoning for every other generated tracked output a --check or verify
# gate byte-compares against a fresh LF render (#49): on a core.autocrlf=true
# checkout the gates would report drift that git itself cannot see.
converted/enraged-eggplant/doa-monsters.reviewed.json text eol=lf
converted/enraged-eggplant/CHECKLIST.md text eol=lf
converted/enraged-eggplant/gcs/*.gct text eol=lf
converted/srd-monsters/doa-monsters.review-required.json text eol=lf
converted/srd-monsters/doa-monsters.reviewed.json text eol=lf
converted/srd-monsters/CHECKLIST.md text eol=lf
converted/srd-monsters/gcs/*.gct text eol=lf
converted/srd-monsters/gcs-sheets/*.gcs text eol=lf

# And for the SRD-coverage specs and everything generated from them, which
# build-srd-monsters.mjs --check compares the same way.
content/srd-monsters/** text eol=lf
converted/srd-monsters/** text eol=lf
