# Private/reference-only source material and local derived working files.
data/

# Generated EE conversion queue remains local until individual records are reviewed.
# Matched per entry, not as a directory: git does not descend into an excluded
# directory, so a negation inside one never takes effect.
converted/enraged-eggplant/*
# ...but the reviewed output and its checklist are tracked: they contain only
# records that carry a review decision, and the publish workflow promotes from
# the reviewed package on a clean checkout, where the local queue does not exist.
!converted/enraged-eggplant/doa-monsters.reviewed.json
!converted/enraged-eggplant/CHECKLIST.md

# Defensive guards: SRD working corpora belong under data/, not tracked sources/.
sources/srd-3-5/raw/
sources/srd-3-5/parsed/
sources/srd-5-1/raw/
sources/srd-5-1/parsed/

# Local generation inputs, scratch queues, and agent state.
tmp/
.agents/
pending.json
scratch.py

# Rejected/alternate image generations are not release assets.
art/enraged-eggplant/review/
art/enraged-eggplant/portraits/*_v[0-9]*.png
art/enraged-eggplant/tokens/*_v[0-9]*.png

# Local-only recovery and experimental generation helpers.
scripts/audit-codex-art.py
scripts/generate-comfy-art.py
scripts/qa-images.py
scripts/reset-by-time.py
scripts/reset-tokens.py
scripts/restore-codex-finals.py

# Generated Python bytecode.
__pycache__/
scripts/__pycache__/
*.py[cod]

# Web thumbnails are derived from portraits and published to R2, not tracked.
art/enraged-eggplant/thumbs/
