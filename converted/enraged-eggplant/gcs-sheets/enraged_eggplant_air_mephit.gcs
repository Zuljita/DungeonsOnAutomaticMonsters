	"notes": [
		{
			"id": "Ah5Iq5PVwk32QzNQy",
			"text": "Typical Stats from the reviewed package: ST 7, DX 13, IQ 9, HT 10, HP 7, WILL 9, PER 10, FP 10, SPEED 6, MOVE 12, DODGE 9, DR 0. GCS derives its own values by applying the ancestry; where the two differ, the package's Typical Stats are what the Dungeons on Automatic encounter tables use."
		},
		{
			"id": "AhS_55rfeJ6jRKegO",
			"text": "Encounter rating: CER 14 (offense 16, protection -2), threat tier minor, appearing 4."
		},
