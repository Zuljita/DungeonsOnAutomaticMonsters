	"notes": [
		{
			"id": "A44s54wqFKZTmV-6N",
			"text": "Typical Stats from the reviewed package: ST 8, DX 11, IQ 10, HT 10, HP 8, WILL 11, PER 10, FP —, SPEED 5.25, MOVE 5, DODGE 8, DR —. GCS derives its own values by applying the ancestry; where the two differ, the package's Typical Stats are what the Dungeons on Automatic encounter tables use."
		},
		{
			"id": "AO02UHnBzvkUVjS3t",
			"text": "Encounter rating: CER 11 (offense 10, protection 1), threat tier minor, appearing 4."
		},
		{
			"id": "AY8S1lI1pIBqD10sx",
			"text": "Touch of Insanity, reach C: Despite being insubstantial, allips can cause temporary insanity with their touch. Any living creature that touches an allip must make a Will roll (Mind Shield provides a bonus to resist, but DR does not) or begin to hallucinate for margin of failure minutes."
		},
		{
			"id": "Au7pU0OG3qJZNeD7u",
			"text": "Babble: When a creature hears the allip’s constant babble, it must roll a Fright Check using the Confusion table (GURPS Powers, p. 85). If a victim succeeds at his Fright Check, he will be unaffected by this ability for one hour."
		},
		{
			"id": "Ap-o2aSyrL6lcBmTS",
			"text": "Madness: When a creature reads the mind of an allip or senses its emotions – by any method, including powers, spells, and unmodified advantages, it must roll a Fright Check. If a victim succeeds at his Fright Check, he will be unaffected by this ability for one hour."
		},
		{
			"id": "ApxBRuVRKLM3KOs_e",
			"text": "GCS ancestry draft: gcs/allip.gct"
		},
		{
			"id": "AIe58YXo4OFjA3dhW",
			"text": "Source template total: 124 points."
		},
		{
			"id": "AbjZ6aNvc77l-_0-P",
			"text": "Library-rebuilt template total: 124 points."
		},
		{
			"id": "Apd3uqQo7kwqpm11j",
			"text": "CER was computed from parsed Typical Stats using the Dungeons On Automatic baseline CER path."
		},
		{
			"id": "AuSYXYGA3mAySnk8y",
			"text": "Review attacks, special abilities, encounter frequency, treasure, grappling, and GCS modifiers before approval."
		},
		{
			"id": "ANm3auV-mESlzNLN3",
			"text": "Original GURPS conversion by Enraged Eggplant, from Monsters (May 11, 2024); adapted and republished with permission."
		}
