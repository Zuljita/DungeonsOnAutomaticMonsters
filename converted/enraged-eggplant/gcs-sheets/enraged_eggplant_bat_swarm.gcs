	"notes": [
		{
			"id": "AbGh8azj3LqRed3JN",
			"text": "Typical Stats from the reviewed package: ST 4, DX 12, IQ 3, HT 12, HP 8, WILL 10, PER 12, FP 10, SPEED 6, MOVE 2, DODGE 9, DR 0. GCS derives its own values by applying the ancestry; where the two differ, the package's Typical Stats are what the Dungeons on Automatic encounter tables use."
		},
		{
			"id": "ApNhJbj22kubnbTFY",
			"text": "Encounter rating: CER 18 (offense 16, protection 2), threat tier minor, appearing 1."
		},
		{
			"id": "AKps4dCOM-qkFEq4Y",
			"text": "Swarm Bite (1d cutting), reach C: No attack roll and no active defense. No attack roll and no active defense. The swarm steps into close combat; the target automatically takes 1d cutting as large-area injury, reduced by DR normally. The only escape is to retreat or dodge-and-drop at least one yard away before the swarm acts."
		},
		{
			"id": "AR_UQifjanbPkm33Y",
			"text": "GCS ancestry draft: gcs/bat-swarm.gct"
		},
		{
			"id": "A0JF4mZ6VCjPzLcYb",
			"text": "Source template total: 17 points."
		},
		{
			"id": "ABnwqVGCO217_tNNV",
			"text": "Library-rebuilt template total: 17 points."
		},
		{
			"id": "Al63LtAf5Nxxpn9ig",
			"text": "CER was computed from parsed Typical Stats using the Dungeons On Automatic baseline CER path."
		},
		{
			"id": "AdSk7GMJdlWisETVE",
			"text": "Review attacks, special abilities, encounter frequency, treasure, grappling, and GCS modifiers before approval."
		},
		{
			"id": "AnDeO-2KFCG3sKRhk",
			"text": "Swarm: the swarm is dispersed at 0 HP and destroyed at -HP. It cannot be slammed or grappled, is immune to crippling injuries, and takes reduced damage from most physical blows (Diffuse, flying swarm)."
		},
		{
			"id": "A24TZvbhwP-CgtdN-",
			"text": "Original GURPS conversion by Enraged Eggplant, from Monsters (May 11, 2024); adapted and republished with permission."
		}
