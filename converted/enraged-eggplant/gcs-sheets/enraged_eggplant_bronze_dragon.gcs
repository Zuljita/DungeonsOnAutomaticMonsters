				{
					"id": "APySqf8mWuOiMxZyO",
					"damage": {
						"type": "cr",
						"base": "3d"
					},
					"usage": "Tail",
					"reach": "C-3",
					"defaults": [
						{
							"type": "10",
							"modifier": 2
						}
