			"melee_weapons": [
				{
					"id": "A3TiKWVlMxK4gp8m5",
					"damage": {
						"type": "cut",
						"base": "2d+2"
					},
					"usage": "Pincers",
					"reach": "C-1",
					"defaults": [
						{
							"type": "10",
							"modifier": 2
						}
					],
					"usage_notes": "Pincers (12): thrust 2d+2 cutting (KYOS: 4d-1 cutting), Reach C-1. The chuul can either nip and let go or hold on and grapple the victim in addition to injuring him. Either is an attack that takes full hit location penalties – not halved for grappling. Treat this attack as a bite for these purposes (see Teeth on page 115 of GURPS Martial Arts for details). The pincers give +2 with tasks that require a firm grip (including climbing)."
				},
				{
					"id": "AJMjBw8xoTrxoHt--",
					"damage": {
						"type": "cr",
						"base": "1d+2"
					},
					"usage": "Weak Bite",
					"reach": "C",
					"defaults": [
						{
							"type": "10",
							"modifier": 2
						}
					],
					"usage_notes": "Weak Bite (12): thrust 1d+2 crushing, Reach C."
				},
				{
					"id": "A9-qUZp44cQnhkD3H",
					"damage": {
						"type": "cr"
					},
					"usage": "Paralytic Tentacles",
					"reach": "C and cannot parry",
					"defaults": [
						{
							"type": "10",
							"modifier": 1
						}
					],
					"usage_notes": "Paralytic Tentacles (11): A chuul can lash out with its tentacles to paralyze his victim. This attack has Reach C and cannot parry. If the tentacle touches bare skin, the victim must roll HT to resist. He becomes paralyzed for 3 seconds per point of margin of failure. After that the subject is stunned (p. B420) and may roll vs. HT once per second to recover."
				}
			]
		}
