	"notes": [
		{
			"id": "Aqx6S9viHl8cvuJOI",
			"text": "Typical Stats from the reviewed package: ST 21, DX 12, IQ 7, HT 11, HP 21, WILL 11, PER 13, FP 11, SPEED 6, MOVE 10, DODGE 10, DR 2. GCS derives its own values by applying the ancestry; where the two differ, the package's Typical Stats are what the Dungeons on Automatic encounter tables use."
		},
		{
			"id": "ArDeZVGLhMGyrj1OY",
			"text": "Encounter rating: CER 42 (offense 22, protection 20), threat tier standard, appearing 1."
		},
		{
			"id": "AmNyup8ncB_BXppb8",
			"text": "Roar (1d fatigue), reach 8 yards: A dragonne can emit a roar that fatigues all other creatures within 8 yards. Every creature that hears this road must make a successful Will roll or lose 1d FP. This ability costs 1 FP and takes 5 seconds to recharge."
		},
		{
			"id": "AXT1KjZuVzJ8fTndd",
			"text": "GCS ancestry draft: gcs/dragonne.gct"
