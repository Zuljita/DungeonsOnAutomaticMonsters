	"notes": [
		{
			"id": "A675SEsd-jWqFbfEk",
			"text": "Typical Stats from the reviewed package: ST 80, DX 10, IQ 13, HT 14, HP 160, WILL 15, PER 13, FP 14, SPEED 6, MOVE 6, DODGE 9, DR 5. GCS derives its own values by applying the ancestry; where the two differ, the package's Typical Stats are what the Dungeons on Automatic encounter tables use."
		},
		{
			"id": "A6Mc2s5_9a_iU4ma-",
			"text": "Encounter rating: CER 216 (offense 50, protection 166), threat tier severe, appearing 1."
		},
		{
			"id": "ATNikUcr33YI03ZQK",
			"text": "GCS ancestry draft: gcs/kraken.gct"
		},
		{
			"id": "Al3F3A8UxspNPYYiP",
			"text": "Source template total: 693 points."
		},
		{
			"id": "AkryqnOQOMe5C-KkV",
			"text": "Library-rebuilt template total: 693 points."
		},
		{
			"id": "AnEyH11dA6voie2DC",
			"text": "CER was computed from parsed Typical Stats using the Dungeons On Automatic baseline CER path."
		},
		{
			"id": "A3V6FwAMeewfPk28a",
			"text": "Review attacks, special abilities, encounter frequency, treasure, grappling, and GCS modifiers before approval."
		},
		{
			"id": "A_779_E9qEgTheCN9",
			"text": "Size 70 hexes; Weight 500,000 lbs."
		},
		{
			"id": "A8pTzMOHmMzOm3_m7",
			"text": "Ink: A kraken may fill a 32-yard-radius area with black ink. No one can see into the affected area, and no one within the affected area can see anything; see p. B394 for combat rules. In addition, this ink cloud imposes a -4 penalty on Smell rolls. A kraken can use this ability only 4 times per day, and only in water or zero-G. Once created, the cloud persists for 10 seconds, drifting with the current."
		},
		{
			"id": "A90dDYIliCMGPDz1Q",
			"text": "Original GURPS conversion by Enraged Eggplant, from Monsters (May 11, 2024); adapted and republished with permission."
		}
	],
