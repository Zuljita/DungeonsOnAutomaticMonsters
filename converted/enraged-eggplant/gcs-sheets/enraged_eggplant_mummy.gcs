	"notes": [
		{
			"id": "AZFGU0YWLFsUKl66z",
			"text": "Typical Stats from the reviewed package: ST 14, DX 10, IQ 8, HT 12, HP 17, WILL 12, PER 10, FP —, SPEED 4.5, MOVE 3, DODGE 7, DR —. GCS derives its own values by applying the ancestry; where the two differ, the package's Typical Stats are what the Dungeons on Automatic encounter tables use."
		},
		{
			"id": "AVTaHh_-CsShy_GZt",
			"text": "Encounter rating: CER 27 (offense 8, protection 19), threat tier standard, appearing 2."
		},
		{
			"id": "ASYy84P-OcWt2vMYT",
			"text": "Despair: When a creature sees the mummy, it must roll a Fright Check at a -2 penalty using the Despair table (Pyramid #3-92, p. 29). If a victim succeeds at his Fright Check, he will be unaffected by this ability for one hour."
		},
		{
			"id": "ADunqn1YM-888Xpte",
			"text": "Mummy Rot (1d-2 toxic), reach C: No attack roll and no active defense. Any creature that touches the mummy with its bare skin must make a successful HT-4 roll or contact mummy rot. This is both a curse and a disease that can only be removed by Remove Curse. This magical affliction sets in one day after contact, dealing 1d-2 toxic damage every day for 60 days."
		},
		{
			"id": "A60uwu2eSIhjMDEP8",
			"text": "GCS ancestry draft: gcs/mummy.gct"
		},
		{
			"id": "AFLCD7MwG0GNKyxKS",
			"text": "Source template total: 230 points."
		},
		{
			"id": "A5y6AkqBXtjj_OiWU",
			"text": "Library-rebuilt template total: 230 points."
		},
		{
			"id": "AbYTC1Oa2IdMMpUTe",
			"text": "CER was computed from parsed Typical Stats using the Dungeons On Automatic baseline CER path."
		},
		{
			"id": "A57GcuqQcofUKT40-",
			"text": "Review attacks, special abilities, encounter frequency, treasure, grappling, and GCS modifiers before approval."
		},
		{
			"id": "AABXYrSUvga_Gwvzk",
			"text": "Original GURPS conversion by Enraged Eggplant, from Monsters (May 11, 2024); adapted and republished with permission."
		}
