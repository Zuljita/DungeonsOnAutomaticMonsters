	"notes": [
		{
			"id": "ADutO1r4SAIVJtSUK",
			"text": "Typical Stats from the reviewed package: ST 4, DX 12, IQ 3, HT 14, HP 6, WILL 9, PER 12, FP 12, SPEED 6, MOVE 4, DODGE 10, DR 0. GCS derives its own values by applying the ancestry; where the two differ, the package's Typical Stats are what the Dungeons on Automatic encounter tables use."
		},
		{
			"id": "Avdr7AQECopgUnjg1",
			"text": "Encounter rating: CER 24 (offense 20, protection 4), threat tier minor, appearing 1."
		},
		{
			"id": "At08eVxf0DyBZi_DD",
			"text": "Swarm Bite (1d cutting), reach C: No attack roll and no active defense. No attack roll and no active defense. The swarm steps into close combat; the target automatically takes 1d cutting as large-area injury, reduced by DR normally. Retreating or dodging and dropping at least one yard away is the only way to avoid it."
		},
		{
			"id": "ARkqrwVYAq4u78mGx",
			"text": "GCS ancestry draft: gcs/rat-swarm.gct"
		},
		{
			"id": "AFYaXRtbrVlcdS-PH",
			"text": "Source template total: 46 points."
		},
		{
			"id": "AF2XG7pzA__2Gu1lo",
			"text": "Library-rebuilt template total: 46 points."
		},
		{
			"id": "AlNAS32_HjLlkbmKt",
			"text": "CER was computed from parsed Typical Stats using the Dungeons On Automatic baseline CER path."
		},
		{
			"id": "AImoR2QeyhQFxfPVD",
			"text": "Review attacks, special abilities, encounter frequency, treasure, grappling, and GCS modifiers before approval."
		},
		{
			"id": "A30i9v7f9UicogKvi",
			"text": "Swarm: the swarm is dispersed at 0 HP and destroyed at -HP. It cannot be slammed or grappled, is immune to crippling injuries, and takes reduced damage from most physical blows (Diffuse)."
		},
		{
			"id": "AP4EHxJEkfp9_7Th8",
			"text": "Original GURPS conversion by Enraged Eggplant, from Monsters (May 11, 2024); adapted and republished with permission."
		}
	],
