				},
				{
					"id": "A-8dBp5Sndw0eZ8Xc",
					"damage": {
						"type": "burn",
						"base": "2d"
					},
					"usage": "Breathe Frost",
					"defaults": [
						{
							"type": "10",
							"modifier": 4
						}
					],
					"usage_notes": "Breathe Frost (14): The dragon breathes out a blast of extremely cold vapor, dealing thrust 2d non-incendiary burning damage as large-area injury. Targets injured by this attack must make an HT roll, at -1 per 2 points of injury, or take a -2 penalty to DX and become Numb (p. B146) for (20-HT) minutes (minimum 1 minute). This is a cone attack that uses rules from Area and Spreading Attacks (pp. B413-414). The cone is 1-yard wide and has a length of 5 yards (ST/5). Each use costs 2 FP. It is possible to make the cone wider by using the rules from Cones of Power (GURPS Dungeon Fantasy Monsters 4: Dragons, p. 10). It will blow out any ordinary fire (candle, lantern, torch, etc.)."
				},
				{
					"id": "AHePaUgJMx2Iv6ahk",
					"damage": {
						"type": "cr"
					},
					"usage": "Breathe Paralyzing Gas",
					"defaults": [
						{
							"type": "10",
							"modifier": 4
						}
					],
					"usage_notes": "Breathe Paralyzing Gas (14): Alternatively, the dragon may breathe out a stream of paralyzing gas. This is a cone attack that uses rules from Area and Spreading Attacks (pp. B413-414). The cone is 1-yard wide and has a length of 5 yards (ST/5). Each use costs 2 FP. It is possible to make the cone wider by using the rules from Cones of Power (GURPS Dungeon Fantasy Monsters 4: Dragons, p. 10). Creatures who breathe the gas must roll against HT or be paralyzed for 2 seconds times margin of failure. After that, the subject is stunned (p. B420) and may roll vs. HT once per second to recover."
				}
			]
		}
