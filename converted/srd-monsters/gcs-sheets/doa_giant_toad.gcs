			"id": "sXmCfCuY3MZlkOU_s",
			"name": "Jumping",
			"difficulty": "dx/e",
			"points": 4,
			"local_notes": "Racial skill at DX+2, level 14."
		},
		{
			"id": "stnVNNvD2BzXYos2y",
			"name": "Stealth",
			"difficulty": "dx/a",
