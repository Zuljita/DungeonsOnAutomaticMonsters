			"id": "srp_GoWe2FvSPuwzI",
			"name": "Occultism",
			"difficulty": "iq/a",
			"points": 8,
			"local_notes": "Racial skill at IQ+2, level 17."
		},
		{
			"id": "skk5DTAIU2yfAGLW9",
			"name": "Tactics",
			"difficulty": "iq/h",
			"points": 4,
			"local_notes": "Racial skill at IQ+0, level 15."
