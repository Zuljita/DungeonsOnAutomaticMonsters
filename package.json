{
  "name": "dungeons-on-automatic-monsters",
  "version": "0.0.1",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "scripts": {
    "fetch:srds": "node scripts/fetch-srds.mjs",
    "parse:srd-3-5": "node scripts/parse-srd-3-5.mjs",
    "parse:srd-5-1": "node scripts/run-python-script.mjs scripts/parse-srd-5-1.py",
    "parse:srds": "npm run parse:srd-3-5 && npm run parse:srd-5-1",
    "convert:enraged-eggplant": "node scripts/run-python-script.mjs .agents/skills/convert-gurps-monsters-to-gcs/scripts/batch_convert_missing.py --overlap data/enraged-eggplant/srd-overlap.json --coverage data/enraged-eggplant/gcs-coverage.json --markdown data/enraged-eggplant/srd-overlap-monsters.md --output-dir converted/enraged-eggplant --selection all --library-root \"data/GCS Master Library\"",
    "validate:gct-enraged-eggplant": "node scripts/run-python-script.mjs .agents/skills/convert-gurps-monsters-to-gcs/scripts/validate_gct.py converted/enraged-eggplant/gcs",
    "validate:enraged-eggplant": "node scripts/validate-package.mjs converted/enraged-eggplant/doa-monsters.review-required.json --allow-review-required",
    "test": "npm run test:unit && npm run validate:public && npm run validate:enraged-eggplant-art && npm run review:audit-traits:check && npm run validate:foundry",
    "test:unit": "node --test \"scripts/test/*.test.mjs\"",
    "validate:public": "node scripts/validate-package.mjs converted/doa-monsters.json",
    "validate:enraged-eggplant-candidate": "node scripts/validate-package.mjs converted/enraged-eggplant/doa-monsters.reviewed.json --allow-unapproved",
    "review:lock": "node scripts/review-lock.mjs",
    "review:queue": "node scripts/review-queue.mjs",
    "review:decide": "node scripts/review-decide.mjs",
    "review:apply": "node scripts/review-apply.mjs",
    "review:verify": "node scripts/review-verify.mjs",
    "review:audit-cer": "node scripts/review-cer-audit.mjs",
    "descriptions:report": "node scripts/build-descriptions.mjs",
    "descriptions:draft": "node scripts/build-descriptions.mjs --draft",
    "descriptions:check": "node scripts/build-descriptions.mjs --check",
    "promote:enraged-eggplant": "node scripts/build-enraged-eggplant-package.mjs",
    "art:enraged-eggplant:manifest": "node scripts/build-enraged-eggplant-image-manifest.mjs",
    "art:enraged-eggplant:hex-tokens": "python scripts/build-hex-token.py --input-dir art/enraged-eggplant/tokens --output-dir art/enraged-eggplant/hex-tokens",
    "validate:enraged-eggplant-art": "node scripts/validate-enraged-eggplant-art.mjs",
    "art:thumbnails": "python scripts/build-web-thumbnails.py --input-dir art/enraged-eggplant/portraits --output-dir art/enraged-eggplant/thumbs",
    "art:upload": "node scripts/upload-art-to-r2.mjs",
    "build:foundry": "node scripts/build-foundry-module.mjs --pack --zip",
    "validate:foundry": "node scripts/validate-foundry-module.mjs",
    "build:gcs-sheets": "node scripts/build-gcs-sheets.mjs",
    "validate:gcs-sheets": "node scripts/build-gcs-sheets.mjs --check",
    "baseline:gcs-sheets": "node scripts/build-gcs-sheets.mjs --baseline",
    "verify:gcs-sheets": "node scripts/verify-gcs-sheets.mjs --report",
    "errata:enraged-eggplant": "node scripts/build-source-errata.mjs",
    "review:audit-traits": "node scripts/review-trait-audit.mjs",
    "review:audit-traits:check": "node scripts/review-trait-audit.mjs --check",
    "report:body-plans": "node scripts/build-body-plan-report.mjs"
  }
}
